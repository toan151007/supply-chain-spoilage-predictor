# Vi du cau hinh backend - Sao chep file nay thanh `.env` o thu muc goc du an
#
#     Copy-Item backend/.env.example .env
#
# `.env` da co trong .gitignore - KHONG BAO GIO commit file do.
# File nay (`.env.example`) KHONG chua mat khau that nen duoc commit de
# thanh huong dan cho người khác clone du an.

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spoilage_predictor
DB_USER=postgres

# THAY bang mat khau that cua may ban.
# Mac dinh cua PostgreSQL khi cai tu postgres.org.
DB_PASSWORD=your_password_here

# ---- CORS ----
# Frontend Vite chay o cong 3000; cong 5173 la fallback mac dinh.
# Chi danh sach origin duoc phep goi API nay.
#
# Ho tro CA HAI dang, tach theo dau phay (de doc hon JSON):
#     CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- JWT / xac thuc ----
# SECRET_KEY chi dung de KY TOKEN, KHONG lien quan mat khau database.
# PHAT TRIEN co the dung gia tri mac dinh trong config.py, nhung PHAI
# THAY khi len production: dat mot chuoi ngau nhien dai, rieng cho tung
# moi truong.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
SECRET_KEY=your_random_secret_key_here_min_32_chars
ALGORITHM=HS256

# Thoi han token (phut cho access, ngay cho refresh)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Tai khoan mau (B12) ----
# Script scripts/reset_user_passwords.py dat mat khau bcrypt cho 3 user
# co san: owner / manager / staff.
# Mat khau PHAT TRIEN:
#     owner   / Owner@2026
#     manager / Manager@2026
#     staff   / Staff@2026
# PHAI doi truoc khi len production.#     CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# config.py doc qua property `cors_origins_list` - xem file do.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI Chatbot Config (Google Gemini) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---- Email thong bao tai khoan (Gmail SMTP) ----
# Dung khi Admin tao tai khoan moi: he thong gui ten dang nhap + mat khau
# toi dia chi email nhap trong form.
#
# MAIL_PASSWORD la MAT KHAU UNG DUNG (App Password) 16 ky tu cua Gmail,
# KHONG phai mat khau dang nhap Gmail.
#   1. Bat 2-Step Verification cho tai khoan Google
#   2. Vao https://myaccount.google.com/apppasswords de tao App Password
#
# Neu de nguyen gia tri mau, backend coi nhu CHUA cau hinh: tai khoan van
# duoc tao nhung API tra ve "Tao thanh cong nhung chua gui duoc mail".
MAIL_USERNAME=email_cua_ban@gmail.com
MAIL_PASSWORD=mat_khau_ung_dung
MAIL_FROM=email_cua_ban@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=FreshChain
# Dat 1 khi can test API ma khong muon gui mail that.
MAIL_SUPPRESS_SEND=0
