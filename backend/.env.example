# Vi du cau hinh backend - Sao chep file nay thanh `.env` o thu muc goc du an
#
#     Copy-Item backend/.env.example .env
#
# `.env` da co trong .gitignore - KHONG BAO GIO commit file do.
# File nay (`.env.example`) KHONG chua mat khau that nen duoc commit de
# thanh huong dan cho người khác clone du an.

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spoilage_predictor
DB_USER=postgres

# THAY bang mat khau that cua may ban.
# Mac dinh cua PostgreSQL khi cai tu postgres.org.
DB_PASSWORD=your_password_here

# ---- CORS ----
# Frontend Vite chay o cong 3000; cong 5173 la fallback mac dinh.
# Chi danh sach origin duoc phep goi API nay.
# Phai la JSON hop le vi config.py doc vao bien kieu list.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173