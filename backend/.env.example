# Vi du cau hinh backend - Sao chep file nay thanh `.env` o thu muc goc du an
#
#     Copy-Item backend/.env.example .env
#
# `.env` da co trong .gitignore - KHONG BAO GIO commit file do.
# File nay (`.env.example`) KHONG chua mat khau that nen duoc commit de
# thanh huong dan cho người khác clone du an.

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spoilage_predictor
DB_USER=postgres

# THAY bang mat khau that cua may ban.
# Mac dinh cua PostgreSQL khi cai tu postgres.org.
DB_PASSWORD=your_password_here

# ---- CORS ----
# Frontend Vite chay o cong 3000; cong 5173 la fallback mac dinh.
# Chi danh sach origin duoc phep goi API nay.
#
# Ho tro CA HAI dang, tach theo dau phay (de doc hon JSON):
#     CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- JWT / xac thuc ----
# SECRET_KEY chi dung de KY TOKEN, KHONG lien quan mat khau database.
# PHAT TRIEN co the dung gia tri mac dinh trong config.py, nhung PHAI
# THAY khi len production: dat mot chuoi ngau nhien dai, rieng cho tung
# moi truong.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
SECRET_KEY=your_random_secret_key_here_min_32_chars
ALGORITHM=HS256

# Thoi han token (phut cho access, ngay cho refresh)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Tai khoan mau (B12) ----
# Script scripts/reset_user_passwords.py dat mat khau bcrypt cho 3 user
# co san: owner / manager / staff.
# Mat khau PHAT TRIEN:
#     owner   / Owner@2026
#     manager / Manager@2026
#     staff   / Staff@2026
# PHAI doi truoc khi len production.#     CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# config.py doc qua property `cors_origins_list` - xem file do.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173